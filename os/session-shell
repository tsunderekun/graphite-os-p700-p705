#!/bin/sh
# Boot session for the graphite shell.
#   /etc/lgtest-mode = shell   -> X + fbpan + graphite-shell
#   any failure / shell exit   -> fallback to the fb player (no X)
LOG=/var/log/graphite-session.log
{
    echo "--- session-shell $(date)"
} >>"$LOG" 2>&1

/usr/local/bin/fbset16 16 || exec /usr/local/bin/lp7player
echo 200 > /sys/class/leds/lcd-backlight/brightness 2>/dev/null
echo 255 > /sys/class/leds/button-backlight/brightness 2>/dev/null

# clean leftovers from a previous session
killall graphite-shell 2>/dev/null
killall fbpan-ng 2>/dev/null
if ! pidof Xorg >/dev/null; then
    rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
fi
sleep 0.5

if [ ! -S /tmp/.X11-unix/X0 ]; then
    X :0 -nolisten tcp -ac vt1 -logfile /var/log/Xorg.0.log >>"$LOG" 2>&1 &
    i=0
    while [ ! -S /tmp/.X11-unix/X0 ] && [ $i -lt 20 ]; do
        sleep 1; i=$((i+1))
    done
fi

if [ ! -S /tmp/.X11-unix/X0 ]; then
    echo "X did not start, falling back to player" >>"$LOG"
    exec /usr/local/bin/lp7player
fi

export DISPLAY=:0
export HOME=/home/user
export XDG_CONFIG_HOME=/home/user/.config
export XDG_CACHE_HOME=/home/user/.cache
xset s off -dpms 2>/dev/null
/usr/local/bin/fbpan-ng 10 >/dev/null 2>&1 &

/usr/local/bin/graphite-shell >>"$LOG" 2>&1
RC=$?
echo "graphite-shell exited rc=$RC, falling back to player" >>"$LOG"

killall fbpan-ng 2>/dev/null
killall Xorg 2>/dev/null
sleep 0.5
exec /usr/local/bin/lp7player
